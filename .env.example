# =============================================================================
# BIBLE REELS — Environment Configuration Template
# 1. cp .env.example .env  |  2. Preencha as chaves  |  3. NUNCA commite .env
# =============================================================================

# Google AI Studio (Gemini Flash - Free Tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Bible API gratuita (sem chave): https://bible-api.com
BIBLE_API_URL=https://bible-api.com
BIBLE_API_KEY=

# Comportamento
CONTENT_LANGUAGE=pt-BR
BIBLE_TRANSLATION=almeida
POSTS_PER_RUN=5

# Caminhos
DB_PATH=data/db/bible_reels.db
OUTPUT_IMAGES_PATH=output/images
OUTPUT_VIDEOS_PATH=output/videos
OUTPUT_QUEUE_PATH=output/queue
FONTS_PATH=data/fonts

# Midia 9:16
CANVAS_WIDTH=1080
CANVAS_HEIGHT=1920
VIDEO_DURATION=15
ENABLE_AUDIO_CTA=true
CTA_VERSE_TEXT="Se essa mensagem falou ao seu coração, curta, salve para lembrar e compartilhe com quem precisa. Siga para receber a Palavra diária."
CTA_SAINT_TEXT="Deixe seu Amém nos comentários, compartilhe essa bênção com sua família e siga nossa página para acompanhar o Santo do Dia."

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=

# Kwai
KWAI_ACCESS_TOKEN=

# Webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

# Postproxy (Multi-plataforma: Instagram, TikTok, YouTube Shorts, etc.) — https://postproxy.dev
POSTPROXY_API_KEY=your_postproxy_api_key_here
POSTPROXY_BASE_URL=https://api.postproxy.dev/api
POSTPROXY_PROFILE_IDS= # IDs dos perfis separados por vírgula (ou deixe vazio para detectar auto)
DEFAULT_PUBLISHER=postproxy # 'postproxy' ou 'webhook'

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bible_reels.log

# Provedores de Imagem FLUX (Cascata: Cloudflare Workers AI -> Hugging Face -> Pollinations -> Unsplash)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HUGGINGFACE_API_TOKEN=



# Integracao VideoFlow
VIDEOFLOW_URL=https://asin-receives-corrected-basketball.trycloudflare.com
