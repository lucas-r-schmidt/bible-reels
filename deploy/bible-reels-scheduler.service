[Unit]
Description=Bible Reels Autonomous Scheduler Daemon (06:00, 12:00 e 18:00)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bible-reels
ExecStart=/home/ubuntu/bible-reels/.venv/bin/python main.py --daemon --video --publisher buffer
Restart=always
RestartSec=15
EnvironmentFile=/home/ubuntu/bible-reels/.env

[Install]
WantedBy=multi-user.target
